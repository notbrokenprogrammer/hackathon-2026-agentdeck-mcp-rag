# Reference only: the application does not load .env automatically.
# Export the variables in your shell before starting the server.
HOST_ADDR=0.0.0.0:8080
DATA_DIR=data
SESSION_TTL=12h

OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
RAG_HYBRID_ENABLED=true
RAG_EMBEDDING_MODEL=embeddinggemma

# Optional: serve the frontend from disk while developing.
# DEV_WEB_DIR=web

# Optional direct TLS. Keep certificates and private keys out of Git.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# PUBLIC_URL=
# TRUST_PROXY=false
